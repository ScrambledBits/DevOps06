# Archivo de deriva: guarda la tasa de error del reloj del sistema
driftfile /var/lib/ntp/drift

# Servidores NTP (pool de México con iburst para sincronización inicial rápida)
pool 0.mx.pool.ntp.org iburst
pool 1.mx.pool.ntp.org iburst
pool 2.mx.pool.ntp.org iburst
pool 3.mx.pool.ntp.org iburst

# Reglas de acceso por defecto: bloquear consultas no autorizadas y modificaciones
restrict default kod nomodify notrap nopeer noquery
restrict -6 default kod nomodify notrap nopeer noquery

# Permitir acceso completo desde el localhost (IPv4 e IPv6)
restrict 127.0.0.1
restrict -6 ::1

# Opcional: permitir que clientes de una red local consulten este servidor
# restrict 192.168.1.0 mask 255.255.255.0 nomodify notrap

# Registro de eventos (opcional)
logfile /var/log/ntp.log
