{#
  Los comentarios entre llaves y numeral son de Jinja: se quedan en tu máquina
  y no llegan al HTML final.

  Esta página mezcla dos tipos de variables:
  - Variables mágicas: Ansible las crea solo a partir del inventario y la
    ejecución. Aquí se usan inventory_hostname, group_names, groups y hostvars.
  - Facts: datos que Ansible recoge del servidor al inicio de cada play
    (gather_facts). Se leen desde el diccionario ansible_facts.
#}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ inventory_hostname }} | DevOps06</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #ccc; }
    .actual { font-weight: bold; }
    .ok { color: #1a7f37; }
    .error { color: #cf222e; }
  </style>
</head>
<body>
  {# Fact: el hostname que reporta el propio sistema, del tipo ip-10-0-1-23. #}
  <h1>Respondió {{ ansible_facts['hostname'] }}</h1>
  <p>Recarga la página: el ALB reparte las peticiones y puede contestar otro frontend.</p>

  <table>
    {# Variable mágica: el nombre del host tal como aparece en el inventario. #}
    <tr><th>Nombre en el inventario</th><td>{{ inventory_hostname }}</td></tr>
    <tr><th>Hostname del sistema</th><td>{{ ansible_facts['hostname'] }}</td></tr>
    <tr><th>IP privada</th><td>{{ ansible_facts['default_ipv4']['address'] }}</td></tr>
    {# Variable del inventario: la IP a la que Ansible se conecta por SSH. #}
    <tr><th>IP pública</th><td>{{ ansible_host }}</td></tr>
    {# Variable mágica: la lista de grupos a los que pertenece este host. #}
    <tr><th>Grupos</th><td>{{ group_names | join(', ') }}</td></tr>
    <tr><th>Sistema</th><td>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</td></tr>
  </table>

  {# Variable mágica: groups tiene todos los grupos del inventario con sus hosts. #}
  <h2>Frontends en el inventario ({{ groups['frontend'] | length }})</h2>
  <ul>
  {% for host in groups['frontend'] %}
    {# hostvars[host] permite leer las variables de otro host, no solo las del actual. #}
    <li{% if host == inventory_hostname %} class="actual"{% endif %}>{{ host }}: {{ hostvars[host]['ansible_host'] }}</li>
  {% endfor %}
  </ul>

  <h2>Conexión con el backend</h2>
  <p>El navegador llama a <a href="/api/">/api/</a> cada 5 segundos. Caddy reenvía esa
  petición al backend y el backend consulta MySQL.</p>
  <table>
    <tr><th>Estado</th><td id="api-estado">Esperando la primera respuesta</td></tr>
    <tr><th>Backend</th><td id="api-backend">-</td></tr>
    <tr><th>MySQL</th><td id="api-mysql">-</td></tr>
    <tr><th>Hora en la base</th><td id="api-hora">-</td></tr>
    <tr><th>Última comprobación</th><td id="api-comprobado">-</td></tr>
  </table>

  <script>
    // Esta parte corre en el navegador, no en Ansible ni en el servidor.
    // Ansible solo copia el texto tal cual, porque no contiene variables de Jinja.
    const INTERVALO_MS = 5000;

    function mostrar(id, texto) {
      // textContent escribe texto plano: si la respuesta trae HTML, no se ejecuta.
      document.getElementById(id).textContent = texto;
    }

    async function comprobarApi() {
      const estado = document.getElementById("api-estado");
      try {
        // no-store evita que el navegador reutilice una respuesta guardada en caché.
        const respuesta = await fetch("/api/", { cache: "no-store" });
        const datos = await respuesta.json();
        // La API responde 200 si llegó a MySQL y 503 si no, pero las dos traen JSON.
        if (respuesta.ok) {
          estado.className = "ok";
          mostrar("api-estado", "Conectado (HTTP " + respuesta.status + ")");
        } else {
          estado.className = "error";
          mostrar("api-estado", "La API responde, pero sin base de datos (HTTP " + respuesta.status + ")");
        }
        mostrar("api-backend", datos.backend);
        mostrar("api-mysql", datos.db === "conectada" ? "MySQL " + datos.mysql_version : datos.detalle);
        mostrar("api-hora", datos.hora_db || "-");
      } catch (error) {
        // fetch falla sin respuesta (red caída) y json() falla si Caddy devuelve
        // un error que no es JSON, por ejemplo un 502 cuando el backend está apagado.
        estado.className = "error";
        mostrar("api-estado", "Sin respuesta del backend: " + error.message);
      }
      mostrar("api-comprobado", new Date().toLocaleTimeString());
      // setTimeout después de terminar, en lugar de setInterval: si el backend
      // tarda más de 5 segundos, las peticiones no se acumulan.
      setTimeout(comprobarApi, INTERVALO_MS);
    }

    comprobarApi();
  </script>
</body>
</html>
