# Archivo administrado por Ansible (rol backend). Contiene la contraseña de la
# base de datos: permisos 0600, solo root lo puede leer.
# systemd lo carga con EnvironmentFile= y cada línea se vuelve una variable de entorno.
DB_HOST={{ db_host }}
DB_NAME={{ db_name }}
DB_USER={{ db_creds.user }}
# Comillas simples: systemd toma el valor literal, así los símbolos de la
# contraseña (#, $, %, etc.) no se interpretan.
DB_PASSWORD='{{ db_creds.password }}'
